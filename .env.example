ENVIRONMENT=development
DATABASE_URL=sqlite:///./doc_agent.db
JWT_SECRET=development-only-change-me
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# 模型接入：fake=本地离线演示 | self=自用 AI | internal=集团内网 API
MODEL_PROVIDER=fake

# @ 自用 AI 接口（OpenAI 兼容，如 DeepSeek）
# 例：SELF_AI_ENDPOINT=https://api.deepseek.com/v1  SELF_AI_MODEL=deepseek-chat
SELF_AI_ENDPOINT=
SELF_AI_API_KEY=
SELF_AI_MODEL=

# @ 集团内网 API 接口（协议待接入时确认；当前按 OpenAI 兼容假设）
INTERNAL_API_ENDPOINT=
INTERNAL_API_KEY=
INTERNAL_API_MODEL=

# 模型调用超时（秒）
PROVIDER_TIMEOUT_SECONDS=30

# 语义检索向量：默认开启。内网离线/无模型缓存时可设 false（退回纯关键词）
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

JOB_HEARTBEAT_SECONDS=30
JOB_STALE_AFTER_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=1

# 跨域白名单（JSON 数组）。留空=关闭跨域；集团内部接入方按需列入，如 ["https://app.example.internal"]
CORS_ALLOWED_ORIGINS=[]

# 服务监听地址。dev 默认本机；内网部署改 BACKEND_HOST=0.0.0.0 供其他机器访问
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
